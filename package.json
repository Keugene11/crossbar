{
  "name": "crossbar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "pnpm --filter @crossbar/gateway dev",
    "build": "pnpm --filter @crossbar/gateway build",
    "start": "pnpm --filter @crossbar/gateway start",
    "test": "pnpm --filter @crossbar/gateway test",
    "test:live": "pnpm --filter @crossbar/gateway test:live",
    "typecheck": "pnpm --filter @crossbar/gateway typecheck && pnpm typecheck:api",
    "typecheck:api": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "pnpm --filter @crossbar/gateway db:migrate",
    "db:seed": "pnpm --filter @crossbar/gateway db:seed",
    "db:generate": "pnpm --filter @crossbar/gateway db:generate",
    "catalog:sync": "pnpm --filter @crossbar/gateway catalog:sync"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "openai": "^7.8.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
