# Comma-separated bearer keys accepted by the gateway.
CROSSBAR_API_KEYS=sk-crossbar-dev

PORT=8080
LOG_LEVEL=info

# Sustained requests per minute per caller (per API key, or per forwarded IP
# when auth is disabled). Set to 0 to turn the limiter off.
CROSSBAR_RATE_LIMIT_RPM=600

# Unset -> embedded PGlite at ./.pglite (real Postgres, no daemon).
# Set    -> node-postgres against that server.
# DATABASE_URL=postgres://crossbar:crossbar@localhost:5432/crossbar

# Upstream provider credentials.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
