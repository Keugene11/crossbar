# Comma-separated bearer keys accepted by the gateway.
CROSSBAR_API_KEYS=sk-crossbar-dev

PORT=8080
LOG_LEVEL=info

# Sustained requests per minute per caller (per API key, or per forwarded IP
# when auth is disabled). Set to 0 to turn the limiter off.
CROSSBAR_RATE_LIMIT_RPM=600

# Unset -> embedded PGlite at ./.pglite (real Postgres, no daemon).
# Set    -> node-postgres against that server.
# DATABASE_URL=postgres://crossbar:crossbar@localhost:5432/crossbar

# Upstream provider credentials. Set the ones you have; models whose provider
# is unconfigured fail their direct attempt and fall through to the aggregator.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=
DASHSCOPE_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=

# A key here makes every model in the catalog reachable as a fallback, even
# ones with no direct provider configured.
OPENROUTER_API_KEY=
